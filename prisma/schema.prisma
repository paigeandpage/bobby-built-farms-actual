generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // POSTGRES_PRISMA_URL is the connection-pooled (pgbouncer) URL — used at
  // runtime for fast serverless queries. POSTGRES_URL_NON_POOLING is a
  // direct connection — required for `prisma db push` / migrations, which
  // can't run over a pooled connection. Both are auto-injected by the
  // Vercel + Neon integration.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  pricePerLb  Float
  imageUrl    String?
  available   Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  clerkUserId     String
  // Optional now: orders generated by a subscription's recurring invoice
  // come from `invoice.paid` and don't have a Checkout Session. The first
  // order of a subscription does have one. One-time orders always do.
  stripeSessionId       String?     @unique
  // Set on every paid order — used to look up the receipt URL on demand.
  // (For one-time payments the Charge holds the receipt; for subscriptions
  // the Invoice holds the hosted PDF.)
  stripePaymentIntentId String?     @unique
  stripeInvoiceId       String?     @unique
  status          OrderStatus @default(PENDING)
  total           Float
  createdAt       DateTime    @default(now())

  // Customer contact info captured at Stripe Checkout
  customerName    String?
  customerEmail   String?
  customerPhone   String?

  // Hand-delivery address captured at Stripe Checkout
  addressLine1      String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String?

  // ZIP the customer typed at the cart-level qualifier. Saved separately
  // so we can spot mismatches between the cart ZIP and the Stripe shipping ZIP.
  deliveryZip     String?

  // Subscription linkage. NULL for one-time purchases. Set both on the
  // initial subscription order and on every renewal order so customers
  // can see which orders belong to which subscription.
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  // True only for the very first order of a subscription (created from
  // `checkout.session.completed`). Renewals (`invoice.paid`) are false.
  isSubscriptionInitial Boolean @default(false)

  // Referral / reward bookkeeping. NULL when the order didn't use any
  // coupon. We store the IDs as plain strings (no FK back-relation) to
  // keep the Order model simple — the source of truth lives on
  // Referral / RewardCoupon respectively.
  //
  // - `referralId` is set when the buyer used a friend's referral
  //   link (the "friend-welcome" $5 off).
  // - `rewardCouponId` is set when the buyer redeemed one of their
  //   own RewardCoupon rows (the "you referred a friend, here's $5"
  //   discount earned previously).
  // - `discountCents` is the total $-off applied at checkout (in
  //   cents) so we can render "Subtotal / Discount / Total" without
  //   re-deriving it from Stripe.
  referralId       String?
  rewardCouponId   String?
  discountCents    Int     @default(0)

  items           OrderItem[]
}

/// A recurring subscription created via Stripe Checkout in `subscription` mode.
/// We snapshot the cart at the time of subscription creation in `cartItems`
/// so we can re-create OrderItems on each renewal invoice without having
/// to round-trip Stripe for line item details.
model Subscription {
  id                   String             @id @default(cuid())
  clerkUserId          String
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus @default(ACTIVE)
  // "month" | "week" — Stripe's recurring.interval. We support monthly
  // (interval=month, count=1) and "twice a month" (interval=week, count=2).
  interval             String
  intervalCount        Int
  cancelAtPeriodEnd    Boolean            @default(false)
  currentPeriodEnd     DateTime?
  // Snapshot of the cart used to create the subscription. Used by the
  // webhook to materialize OrderItems for each renewal invoice.
  cartItems            Json
  // Snapshot of customer contact info — populated from the initial
  // Checkout Session and used for renewal-order emails.
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  deliveryZip          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  orders               Order[]

  @@index([clerkUserId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  weightLbs  Float
  pricePerLb Float
  subtotal   Float
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

/// A record of someone who explicitly opted in to receive marketing
/// emails from us. The fields here are deliberately verbose because
/// they double as a legally-defensible "certificate of consent" — if
/// we ever import this list into Mailchimp / Klaviyo / etc., we want
/// to be able to prove (per email address) exactly what the customer
/// agreed to, when, where, and from what device.
///
/// Mailchimp's CSV importer accepts OPTIN_TIME / OPTIN_IP columns
/// for GDPR compliance. The CSV export endpoint
/// (`/api/admin/newsletter/export`) maps the fields here onto those
/// column names so the file can be uploaded directly without
/// massaging.
model NewsletterSubscriber {
  id              String                     @id @default(cuid())
  email           String                     @unique
  name            String?
  /// Where on the site the customer opted in — "footer", "homepage",
  /// "checkout", "account", "signup-page", etc. Useful for tuning
  /// where the form pulls weight.
  source          String
  /// Verbatim text the customer agreed to. Stored per-row (not as a
  /// foreign key to a versions table) so changing the global consent
  /// language never silently rewrites history.
  consentText     String
  consentVersion  String                     @default("1.0")
  /// Truthful timestamp of the moment the box was checked. Mapped to
  /// Mailchimp's OPTIN_TIME on export.
  optInAt         DateTime                   @default(now())
  /// Captured from `x-forwarded-for` / req IP — never user-supplied.
  /// Mapped to Mailchimp's OPTIN_IP on export.
  optInIp         String?
  optInUserAgent  String?
  /// Set if/when they ever click an unsubscribe link or we get a
  /// bounce. Status is the primary filter — the timestamp is just for
  /// auditability.
  status          NewsletterStatus           @default(ACTIVE)
  unsubscribedAt  DateTime?
  unsubscribeReason String?
  /// Random token for one-click unsubscribe links in our emails.
  /// Generated on insert; rotated only if compromised.
  unsubscribeToken String                    @unique @default(cuid())
  /// If the visitor was signed in when they opted in, link the row
  /// back to their Clerk user. Optional — most signups happen
  /// anonymously from the footer.
  clerkUserId     String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([status])
  @@index([source])
  @@index([clerkUserId])
}

enum NewsletterStatus {
  ACTIVE
  UNSUBSCRIBED
}

/// A cart snapshot stashed before redirecting to Stripe Checkout.
///
/// Stripe metadata values are capped at 500 characters per key, which
/// breaks once a cart hits ~6+ items. Instead of inlining the cart in
/// `metadata.cartItems`, we persist it here, send only the row id in
/// metadata, and let the webhook read the full snapshot back. Cleaned
/// up periodically — abandoned rows are harmless but let's not let
/// them grow forever.
model PendingCheckout {
  id                    String   @id @default(cuid())
  clerkUserId           String?
  cartItems             Json
  // "one-time" | "weekly" | "biweekly" | "monthly"
  subscriptionFrequency String
  deliveryZip           String?
  // Marketing-email opt-in captured on the cart page. The webhook
  // reads this back after `checkout.session.completed` and (if true)
  // records a NewsletterSubscriber using the email Stripe collected.
  // `consentIp` / `consentUserAgent` snapshot the *customer's*
  // request — not Stripe's — because the webhook itself comes from
  // Stripe's IP and would otherwise destroy the audit trail.
  marketingConsent      Boolean  @default(false)
  consentIp             String?
  consentUserAgent      String?
  createdAt             DateTime @default(now())

  @@index([createdAt])
}

// ─── Referral program ─────────────────────────────────────────────────────
//
// $5-off-for-them, $5-off-for-you. Every signed-in customer gets a
// unique, shareable ReferralCode. When a friend clicks the link we
// drop a cookie; on their next checkout we apply a $5 friend-welcome
// discount and record a Referral. When that order pays, we issue a
// RewardCoupon to the original referrer (also $5 off), auto-applied
// the next time they check out.

/// One shareable code per Clerk user. Lazily created the first time
/// the user opens their "Refer a friend" panel (or when they hit any
/// code lookup endpoint signed in). `code` is short and human-typable
/// (e.g. "BBF-7K2DXM") so it can survive being read aloud or copied
/// out of a text message.
model ReferralCode {
  id          String     @id @default(cuid())
  clerkUserId String     @unique
  code        String     @unique
  createdAt   DateTime   @default(now())
  referrals   Referral[]

  @@index([code])
}

/// One row per redemption attempt. Created with status=PENDING the
/// moment the cart server applies a friend-welcome discount; flipped
/// to COMPLETED by the Stripe webhook after the referee's order is
/// paid. `refereeOrderId` and `rewardCouponId` are filled at
/// completion so admin queries can pivot in either direction.
model Referral {
  id                  String         @id @default(cuid())
  code                String
  referralCode        ReferralCode   @relation(fields: [code], references: [code])
  referrerClerkUserId String
  refereeEmail        String?
  refereeClerkUserId  String?
  refereeOrderId      String?        @unique
  status              ReferralStatus @default(PENDING)
  /// The RewardCoupon we issued to the referrer once this referral
  /// completed. NULL until the webhook fires.
  rewardCouponId      String?        @unique
  createdAt           DateTime       @default(now())
  completedAt         DateTime?

  @@index([referrerClerkUserId])
  @@index([code])
  @@index([status])
}

enum ReferralStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// A $5-off coupon owned by a specific customer. Issued in two
/// scenarios:
///   - reason = "referrer-reward"  — paid out to the referrer after
///                                   their friend's order is paid.
///   - reason = "friend-welcome"   — (reserved) future use if we
///                                   ever want to pre-mint codes
///                                   instead of generating Stripe
///                                   coupons on the fly. Today the
///                                   friend-welcome discount is
///                                   applied inline at checkout and
///                                   doesn't have a RewardCoupon row.
///
/// Auto-applied at the owner's next checkout (oldest unredeemed
/// first). `stripeCouponId` is the underlying Stripe Coupon used to
/// realize the discount on the Checkout Session.
model RewardCoupon {
  id                    String    @id @default(cuid())
  /// Short human-typable id ("RWD-7K2DXM"). We don't currently
  /// expose a "type to redeem" UI — auto-apply handles everything —
  /// but storing a human-readable code makes support / refunds
  /// dramatically easier.
  code                  String    @unique
  clerkUserId           String?
  email                 String?
  amountOffCents        Int
  reason                String
  stripeCouponId        String?
  stripePromotionCodeId String?
  redeemedAt            DateTime?
  redeemedOrderId       String?   @unique
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([clerkUserId])
  @@index([email])
  @@index([code])
}
